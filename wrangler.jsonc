// The Worker: serves dist/ (the built app) and the /api routes, and runs the
// alerts cron. Cloudflare builds and deploys it from GitHub (see README).
{
  "name": "baller-buddy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /#/route links are client-side, but unknown paths should still open the app
    "not_found_handling": "single-page-application",
    // the API must reach the Worker, not the single-page fallback
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "PUSH", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "observability": { "enabled": true }
}
